#!/usr/bin/env bash
# bpp-ctl - jedyny punkt wejscia dla aplikacji Windows:
#   wsl -d BPP -u root -- /opt/bpp/bin/bpp-ctl <polecenie>
# stdout: wylacznie linie JSON (emit) - wyjatki: `status` (jedna linia JSON), `logs`, `diag`,
# `compose` (zwykly tekst) i `ca-cert` (PEM). Logi dla ludzi i wyjscie dockera ida na stderr.
# Kod wyjscia != 0 <=> ostatnie zdarzenie to "error".
set -Eeuo pipefail

BPP_HOME="${BPP_HOME:-/opt/bpp}"
export BPP_HOME
_CTL_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"
# shellcheck source-path=SCRIPTDIR/../lib source=events.sh
source "$_CTL_LIB/events.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=hosts.sh
source "$_CTL_LIB/hosts.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=cert.sh
source "$_CTL_LIB/cert.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=state.sh
source "$_CTL_LIB/state.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=pull.sh
source "$_CTL_LIB/pull.sh"

export LC_NUMERIC=C

fail() {
  follow_logs_stop
  emit error null "$1"
  exit 1
}

# follow_logs_start / follow_logs_stop - (tylko init) logi bazy i aplikacji na stderr w trakcie pierwszego
# startu: instalator pokazuje stderr w oknie terminala, wiec widac migracje zamiast kilku minut ciszy.
# Proces w tle jest zawsze konczony (takze w fail), bo trzyma otwarty stderr, na ktory czeka aplikacja Windows.
LOGS_PID=""
follow_logs_start() {
  (
    until [ -n "$(bpp_compose ps --all -q appserver 2>/dev/null)" ]; do sleep 1; done
    # exec: kill ma trafic w docker compose, nie w powloke-rodzica
    exec docker compose --project-directory "$BPP_HOME" -f "$BPP_HOME/docker-compose.yml" \
      --env-file "$BPP_HOME/state/.env" logs --follow --no-color --tail 50 dbserver appserver
  ) </dev/null >&2 &
  LOGS_PID=$!
}
follow_logs_stop() {
  [ -n "$LOGS_PID" ] || return 0
  kill "$LOGS_PID" 2>/dev/null || true
  wait "$LOGS_PID" 2>/dev/null || true
  LOGS_PID=""
}

trap 'fail "Nieoczekiwany błąd bpp-ctl (linia $LINENO)"' ERR

# service_health <usluga> -> starting|healthy|unhealthy|absent
service_health() {
  local json health state
  json="$(bpp_compose ps --all --format json "$1" 2>/dev/null || true)"
  [ -n "$json" ] || {
    echo absent
    return 0
  }
  health="$(jq -rs 'flatten | .[0].Health // ""' <<<"$json" 2>/dev/null || true)"
  state="$(jq -rs 'flatten | .[0].State // ""' <<<"$json" 2>/dev/null || true)"
  case "$health" in
    starting | healthy | unhealthy) echo "$health" ;;
    *) if [ "$state" = running ] || [ "$state" = restarting ]; then echo starting; else echo absent; fi ;;
  esac
}

appserver_health() { service_health appserver; }

# wait_services - (tylko init) czeka, az wstana takze nginx i uslugi w tle, zeby "gotowe" w instalatorze
# znaczylo dzialajacy system. Miekko: po BPP_SERVICES_WAIT_TIMEOUT s (domyslnie 180) idzie dalej - aplikacja
# dziala bez workera, a jego stan widac w `bpp-ctl diag`.
wait_services() {
  local timeout="${BPP_SERVICES_WAIT_TIMEOUT:-180}" interval="${BPP_HEALTH_INTERVAL:-5}" deadline pending svc
  deadline=$((SECONDS + timeout))
  while :; do
    pending=""
    for svc in webserver workerserver celerybeat; do
      [ "$(service_health "$svc")" = healthy ] || pending+="${pending:+, }$svc"
    done
    [ -n "$pending" ] || return 0
    if ((SECONDS >= deadline)); then
      echo "Usługi w tle jeszcze się uruchamiają ($pending) - BPP działa, dokończą start same." >&2
      return 0
    fi
    emit services null "Uruchamianie usług w tle: $pending"
    sleep "$interval"
  done
}

# demo_data <motyw> - (tylko init) generuje dane demo generatorem BPP: slownik dyscyplin, create_demo_data,
# denorm_flush (opisy bibliograficzne). Raz: znacznik state/demo chroni przed powtorka przy ponowionym init
# (druga runda dopisalaby drugi komplet). Miekko: blad nie psuje instalacji - BPP dziala, tylko bez danych demo.
# _demo_manage <message> <manage.py args...> - announces one stage of the demo data (the installer shows the
# message as its status) and runs that manage.py command in appserver. The command's output goes to stderr,
# i.e. to the installer's terminal: progress bars redraw with \r, hence the tr, and tr must not buffer -
# into a pipe it would hold the text back in blocks, so the terminal would stand still on a stale line
# while the work goes on.
_demo_manage() {
  local message="$1"
  shift
  emit demo null "$message"
  timeout "${BPP_DEMO_TIMEOUT:-3600}" docker compose --project-directory "$BPP_HOME" \
    -f "$BPP_HOME/docker-compose.yml" --env-file "$BPP_HOME/state/.env" exec -T appserver \
    python src/manage.py "$@" 2>&1 | stdbuf -o0 tr '\r' '\n' >&2
}

demo_data() {
  local theme="$1" marker="$BPP_HOME/state/demo" what="Pierwszy start BPP: dane demo"
  if [ -f "$marker" ]; then
    emit demo null "Dane demo są już zainstalowane"
    return 0
  fi
  # znacznik przed generowaniem: po przerwaniu w polowie nie dopisujemy drugiego kompletu
  printf '%s\n' "$theme" >"$marker"
  if _demo_manage "$what — słownik dyscyplin (1 z 3)" seed_default_dyscypliny &&
    _demo_manage "$what — autorzy i publikacje (2 z 3, kilka minut)" \
      create_demo_data --motyw "$theme" --autorow 200 --ile-ciaglych 1000 --ile-zwartych 500 \
      --yes-i-am-sure --confirm-db bpp --manifest-out /tmp/demo_data_manifest.json &&
    _demo_manage "$what — opisy bibliograficzne (3 z 3, kilka minut)" denorm_flush; then
    emit demo null "Dane demo zainstalowane"
  else
    echo "Nie udało się wygenerować danych demo - BPP działa bez nich." >&2
    emit demo null "Nie udało się wygenerować danych demo — BPP działa bez nich"
  fi
}

# wait_docker [event] - czeka (do BPP_DOCKER_WAIT_TIMEOUT s, domyslnie 60), az demon Dockera
# odpowie na `docker info`: przy zimnym starcie dystrybucji dockerd moze jeszcze nie wstac.
# Z "event" komunikat idzie tez jako zdarzenie config (init/start); bez - tylko na stderr
# (stop: stdout ma zostac pusty).
wait_docker() {
  local timeout="${BPP_DOCKER_WAIT_TIMEOUT:-60}" interval="${BPP_DOCKER_WAIT_INTERVAL:-1}" deadline
  docker info >/dev/null 2>&1 && return 0
  deadline=$((SECONDS + timeout))
  echo "Oczekiwanie na uruchomienie Dockera (do $timeout s)..." >&2
  [ "${1:-}" != event ] || emit config null "Oczekiwanie na uruchomienie Dockera"
  until docker info >/dev/null 2>&1; do
    ((SECONDS < deadline)) || fail "Docker nie wystartował w ciągu $timeout s"
    sleep "$interval"
  done
}

wait_healthy() {
  local interval="${BPP_HEALTH_INTERVAL:-5}" h
  while :; do
    h="$(appserver_health)"
    case "$h" in
      healthy) return 0 ;;
      unhealthy) fail "Aplikacja BPP zgłosiła stan unhealthy" ;;
    esac
    ((SECONDS < DEADLINE)) || fail "Przekroczono limit czasu oczekiwania na start aplikacji (${BPP_HEALTH_TIMEOUT:-1800} s)"
    sleep "$interval"
  done
}

# parse_hosts <args...> -> ustawia HOSTS i (init, opcja --demo <motyw>) DEMO_THEME. Z PARSE_HOSTS_DEFAULT_SAVED=1 (start) brak --hosts
# oznacza liste z ostatniego uruchomienia (state/hosts) - do recznego `bpp-ctl start`.
parse_hosts() {
  HOSTS=""
  DEMO_THEME=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --demo)
        # tylko init: dane demo generuje sie raz, przy pierwszym starcie
        [ "${PARSE_ALLOW_DEMO:-0}" = 1 ] || fail "Nieznany argument: $1"
        [ "$#" -ge 2 ] || fail "Brak wartości dla --demo"
        case "$2" in
          realistyczny | lem | wiedzmin) DEMO_THEME="$2" ;;
          *) fail "Nieznany motyw danych demo: $2" ;;
        esac
        shift 2
        ;;
      --hosts)
        [ "$#" -ge 2 ] || fail "Brak wartości dla --hosts"
        HOSTS="$2"
        shift 2
        ;;
      *) fail "Nieznany argument: $1" ;;
    esac
  done
  if [ -z "$HOSTS" ] && [ "${PARSE_HOSTS_DEFAULT_SAVED:-0}" = 1 ] && [ -s "$BPP_HOME/state/hosts" ]; then
    HOSTS="$(head -n 1 "$BPP_HOME/state/hosts")"
  fi
  [ -n "$HOSTS" ] || fail "Wymagany argument --hosts <lista>"
  hosts_validate "$HOSTS" || fail "Nieprawidłowa lista hostów: $HOSTS"
}

# ensure_hosts_config - certyfikat, state/hosts.env i state/hosts dla $HOSTS;
# regeneruje tylko przy zmianie listy hostow, braku plikow, zblizajacym sie koncu waznosci certyfikatu
# albo gdy certyfikat nie pochodzi od lokalnego CA (state/ca; instalacja sprzed CA lub CA wymienione).
# Ustawia CERT_CHANGED=1, gdy cos wygenerowano (init -> start: flaga przetrwa,
# wiec nginx zostanie przeladowany, jesli juz dziala).
CERT_CHANGED=0
ensure_hosts_config() {
  if state_hosts_changed "$HOSTS" || [ ! -f "$BPP_HOME/state/ssl/cert.pem" ] || [ ! -f "$BPP_HOME/state/hosts.env" ] ||
    cert_needs_renewal "$BPP_HOME/state/ssl" || ! cert_signed_by_ca "$BPP_HOME/state/ssl" "$BPP_HOME/state/ca"; then
    CERT_CHANGED=1
    emit cert null "Generowanie certyfikatu dla: $HOSTS"
    cert_generate "$HOSTS" "$BPP_HOME/state/ssl" "$BPP_HOME/state/ca" || fail "Nie udało się wygenerować certyfikatu"
    hosts_render_env "$HOSTS" >"$BPP_HOME/state/hosts.env" || fail "Nie udało się zapisać hosts.env"
    printf '%s\n' "$HOSTS" >"$BPP_HOME/state/hosts"
  fi
}

cmd_start() {
  local web_running="" rc
  PARSE_HOSTS_DEFAULT_SAVED=1 parse_hosts "$@"
  hwclock -s 2>/dev/null || true
  emit config null "Sprawdzanie konfiguracji"
  [ -f "$BPP_HOME/state/.env" ] || fail "Brak konfiguracji (state/.env) - uruchom najpierw init"
  wait_docker event

  ensure_hosts_config

  web_running="$(bpp_compose ps --status running -q webserver 2>/dev/null || true)"
  emit start null "Uruchamianie usług"
  # `up -d` blokuje na zdrowiu appservera (depends_on), czyli na migracjach:
  # migrate emitujemy przed nim, a calosc ograniczamy wspolnym limitem czasu.
  if [ "${BPP_INSTALL_MODE:-0}" = 1 ]; then
    emit migrate null "Pierwszy start BPP: tworzenie bazy danych (może potrwać kilka minut)"
  else
    emit migrate null "Migracje bazy i start aplikacji (może potrwać kilka minut)"
  fi
  DEADLINE=$((SECONDS + ${BPP_HEALTH_TIMEOUT:-1800}))
  [ "${BPP_INSTALL_MODE:-0}" != 1 ] || follow_logs_start
  export -f bpp_compose
  rc=0
  timeout "${BPP_HEALTH_TIMEOUT:-1800}" bash -c 'bpp_compose up -d >&2' || rc=$?
  [ "$rc" -ne 124 ] || fail "Przekroczono limit czasu oczekiwania na start aplikacji (${BPP_HEALTH_TIMEOUT:-1800} s)"
  [ "$rc" -eq 0 ] || fail "docker compose up nie powiodło się"
  if [ "$CERT_CHANGED" = 1 ] && [ -n "$web_running" ]; then
    bpp_compose exec -T webserver nginx -s reload >&2 || fail "Nie udało się przeładować nginx"
  fi

  wait_healthy
  follow_logs_stop
  if [ "${BPP_INSTALL_MODE:-0}" = 1 ]; then
    [ -z "${INIT_DEMO_THEME:-}" ] || demo_data "$INIT_DEMO_THEME"
    wait_services
  fi
  emit ready 1 "BPP jest gotowe: https://localhost:8443"
}

cmd_init() {
  PARSE_ALLOW_DEMO=1 parse_hosts "$@"
  INIT_DEMO_THEME="$DEMO_THEME"
  emit config null "Przygotowanie konfiguracji"
  wait_docker event
  state_ensure_env || fail "Nie udało się utworzyć state/.env (brak image-tag?)"
  # compose (config --images) wymaga plikow env_file, w tym state/hosts.env.
  ensure_hosts_config
  pull_with_progress || fail "Pobieranie obrazów nie powiodło się"
  # pierwszy start pod okiem instalatora: logi uslug na stderr i czekanie na wszystkie uslugi
  BPP_INSTALL_MODE=1
  cmd_start --hosts "$HOSTS"
}

cmd_stop() {
  wait_docker
  bpp_compose stop >&2 || fail "docker compose stop nie powiodło się"
}

# status - one JSON line for the tray icon, which asks every few seconds:
#   {"running":bool,"health":"...","docker":bool,"services":[{"name":"...","state":"...","health":"..."},...]}
# "docker" says whether the daemon answers; "services" lists every service of the stack in compose order,
# with the container's state and health as Docker reports them (a service without a container has state
# "absent", one without a healthcheck has an empty health). "running" and "health" describe appserver.
# Never waits for Docker and never fails.
cmd_status() {
  local docker=false names="" ps="" rows=""
  if timeout 10 docker info >/dev/null 2>&1; then
    docker=true
    names="$(bpp_compose config --services 2>/dev/null || true)"
    ps="$(bpp_compose ps --all --format json 2>/dev/null || true)"
  fi
  # compose prints one object per line or, in older versions, one array
  rows="$(jq -cs 'flatten' <<<"$ps" 2>/dev/null || true)"
  [ -n "$rows" ] || rows='[]'
  jq -cn --argjson docker "$docker" --arg names "$names" --argjson rows "$rows" '
    ($names | split("\n") | map(select(length > 0))) as $expected
    | ($rows | map({name: .Service, state: (.State // ""), health: (.Health // "")})) as $have
    | ($expected + (($have | map(.name)) - $expected)) as $all
    | [$all[] as $n | (($have | map(select(.name == $n)) | .[0]) // {name: $n, state: "absent", health: ""})]
      as $services
    | (($services | map(select(.name == "appserver")) | .[0]) // {state: "absent", health: ""}) as $app
    | {
        running: ($app.state == "running"),
        health: (
          if $app.state == "absent" then "absent"
          elif ($app.health | IN("starting", "healthy", "unhealthy")) then $app.health
          elif ($app.state | IN("running", "restarting")) then "starting"
          else "absent" end),
        docker: $docker,
        services: $services
      }'
}

cmd_logs() {
  bpp_compose logs --tail 500 --no-color "$@" || fail "docker compose logs nie powiodło się"
}

# ca-cert - certyfikat lokalnego CA (PEM) na stdout; aplikacja Windows dodaje go do zaufanych urzedow
# biezacego uzytkownika, zeby przegladarka nie ostrzegala przed https://localhost:8443.
cmd_ca-cert() {
  [ -f "$BPP_HOME/state/ca/ca.pem" ] || fail "Brak certyfikatu CA (state/ca/ca.pem) - uruchom najpierw init lub start"
  cat "$BPP_HOME/state/ca/ca.pem"
}

# compose <args...> - docker compose tego stosu (state/.env, project-directory) do recznej pracy:
#   wsl -d BPP bpp-ctl compose ps | logs workerserver | up -d
cmd_compose() {
  trap - ERR
  wait_docker
  exec docker compose --project-directory "$BPP_HOME" -f "$BPP_HOME/docker-compose.yml" \
    --env-file "$BPP_HOME/state/.env" "$@"
}

# diag - raport diagnostyczny (zwykly tekst na stdout) do zgloszenia w IPLweb. Nigdy nie konczy sie
# bledem: kazda sekcja dziala osobno. Bez sekretow: nie pokazuje state/.env ani `compose config`.
cmd_diag() {
  trap - ERR
  set +e
  _section() {
    printf '\n===== %s =====\n' "$1"
    shift
    "$@" 2>&1
    local rc=$?
    [ "$rc" -eq 0 ] || echo "(kod wyjścia: $rc)"
  }
  echo "BPP - diagnostyka ($(date -Is 2>/dev/null || date))"
  _section "System" bash -c 'uname -a; grep PRETTY_NAME /etc/os-release; uptime; nproc'
  _section "Pamięć" free -m
  _section "Dysk" df -h / /var/lib/docker
  _section "Konfiguracja BPP (bez haseł)" bash -c '
    echo "image-tag: $(cat "$BPP_HOME/image-tag" 2>/dev/null)"
    grep -E "^BPP_IMAGE_TAG=" "$BPP_HOME/state/.env" 2>/dev/null
    echo "hosts: $(cat "$BPP_HOME/state/hosts" 2>/dev/null)"
    ls -l "$BPP_HOME/state" 2>/dev/null'
  _section "Usługa docker" systemctl --no-pager status docker
  if ! timeout 60 bash -c 'until docker info >/dev/null 2>&1; do sleep 1; done'; then
    echo
    echo "Docker nie odpowiada - pomijam sekcje kontenerów."
    _section "Dziennik dockerd" journalctl -u docker --no-pager -n 200
    return 0
  fi
  _section "Docker" docker version
  _section "Obrazy" docker images
  _section "Kontenery (compose ps -a)" bpp_compose ps --all
  _section "Healthcheck kontenerów" bash -c '
    for c in $(docker ps -aq --filter label=com.docker.compose.project=bpp); do
      docker inspect --format "{{.Name}}: state={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} restarts={{.RestartCount}} started={{.State.StartedAt}}" "$c"
      docker inspect --format "{{if .State.Health}}{{range .State.Health.Log}}  [{{.ExitCode}}] {{.Start}} {{printf \"%.300s\" .Output}}{{println}}{{end}}{{end}}" "$c"
    done'
  _section "Zużycie zasobów" docker stats --no-stream --no-trunc
  _section "Logi usług (ostatnie 1000 linii każdej)" bpp_compose logs --tail 1000 --timestamps --no-color
  _section "Dziennik dockerd" journalctl -u docker --no-pager -n 200
  _section "Jądro (OOM)" bash -c 'dmesg 2>/dev/null | grep -iE "oom|killed process" | tail -n 50'
  return 0
}

main() {
  local cmd="${1:-}"
  [ "$#" -eq 0 ] || shift
  case "$cmd" in
    init | start | stop | status | logs | diag | compose | ca-cert) "cmd_$cmd" "$@" ;;
    *) fail "Nieznane polecenie: '${cmd}' (init|start|stop|status|logs|diag|compose|ca-cert)" ;;
  esac
}

main "$@"
