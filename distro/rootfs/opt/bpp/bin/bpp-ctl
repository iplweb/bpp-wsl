#!/usr/bin/env bash
# bpp-ctl - jedyny punkt wejscia dla aplikacji Windows:
#   wsl -d BPP -u root -- /opt/bpp/bin/bpp-ctl <polecenie>
# stdout: wylacznie linie JSON (emit) - wyjatki: `status` (jedna linia JSON), `logs`, `diag`
# i `compose` (zwykly tekst). Logi dla ludzi i wyjscie dockera ida na stderr.
# Kod wyjscia != 0 <=> ostatnie zdarzenie to "error".
set -Eeuo pipefail

BPP_HOME="${BPP_HOME:-/opt/bpp}"
export BPP_HOME
_CTL_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"
# shellcheck source-path=SCRIPTDIR/../lib source=events.sh
source "$_CTL_LIB/events.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=hosts.sh
source "$_CTL_LIB/hosts.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=cert.sh
source "$_CTL_LIB/cert.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=state.sh
source "$_CTL_LIB/state.sh"
# shellcheck source-path=SCRIPTDIR/../lib source=pull.sh
source "$_CTL_LIB/pull.sh"

export LC_NUMERIC=C

fail() {
  emit error null "$1"
  exit 1
}

trap 'fail "Nieoczekiwany błąd bpp-ctl (linia $LINENO)"' ERR

# appserver_health -> starting|healthy|unhealthy|absent
appserver_health() {
  local json health state
  json="$(bpp_compose ps --all --format json appserver 2>/dev/null || true)"
  [ -n "$json" ] || {
    echo absent
    return 0
  }
  health="$(jq -rs 'flatten | .[0].Health // ""' <<<"$json" 2>/dev/null || true)"
  state="$(jq -rs 'flatten | .[0].State // ""' <<<"$json" 2>/dev/null || true)"
  case "$health" in
    starting | healthy | unhealthy) echo "$health" ;;
    *) if [ "$state" = running ] || [ "$state" = restarting ]; then echo starting; else echo absent; fi ;;
  esac
}

# wait_docker [event] - czeka (do BPP_DOCKER_WAIT_TIMEOUT s, domyslnie 60), az demon Dockera
# odpowie na `docker info`: przy zimnym starcie dystrybucji dockerd moze jeszcze nie wstac.
# Z "event" komunikat idzie tez jako zdarzenie config (init/start); bez - tylko na stderr
# (stop: stdout ma zostac pusty).
wait_docker() {
  local timeout="${BPP_DOCKER_WAIT_TIMEOUT:-60}" interval="${BPP_DOCKER_WAIT_INTERVAL:-1}" deadline
  docker info >/dev/null 2>&1 && return 0
  deadline=$((SECONDS + timeout))
  echo "Oczekiwanie na uruchomienie Dockera (do $timeout s)..." >&2
  [ "${1:-}" != event ] || emit config null "Oczekiwanie na uruchomienie Dockera"
  until docker info >/dev/null 2>&1; do
    ((SECONDS < deadline)) || fail "Docker nie wystartował w ciągu $timeout s"
    sleep "$interval"
  done
}

wait_healthy() {
  local interval="${BPP_HEALTH_INTERVAL:-5}" h
  while :; do
    h="$(appserver_health)"
    case "$h" in
      healthy) return 0 ;;
      unhealthy) fail "Aplikacja BPP zgłosiła stan unhealthy" ;;
    esac
    ((SECONDS < DEADLINE)) || fail "Przekroczono limit czasu oczekiwania na start aplikacji (${BPP_HEALTH_TIMEOUT:-1800} s)"
    sleep "$interval"
  done
}

# parse_hosts <args...> -> ustawia HOSTS. Z PARSE_HOSTS_DEFAULT_SAVED=1 (start) brak --hosts
# oznacza liste z ostatniego uruchomienia (state/hosts) - do recznego `bpp-ctl start`.
parse_hosts() {
  HOSTS=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --hosts)
        [ "$#" -ge 2 ] || fail "Brak wartości dla --hosts"
        HOSTS="$2"
        shift 2
        ;;
      *) fail "Nieznany argument: $1" ;;
    esac
  done
  if [ -z "$HOSTS" ] && [ "${PARSE_HOSTS_DEFAULT_SAVED:-0}" = 1 ] && [ -s "$BPP_HOME/state/hosts" ]; then
    HOSTS="$(head -n 1 "$BPP_HOME/state/hosts")"
  fi
  [ -n "$HOSTS" ] || fail "Wymagany argument --hosts <lista>"
  hosts_validate "$HOSTS" || fail "Nieprawidłowa lista hostów: $HOSTS"
}

# ensure_hosts_config - certyfikat, state/hosts.env i state/hosts dla $HOSTS;
# regeneruje tylko przy zmianie listy hostow albo braku plikow.
# Ustawia CERT_CHANGED=1, gdy cos wygenerowano (init -> start: flaga przetrwa,
# wiec nginx zostanie przeladowany, jesli juz dziala).
CERT_CHANGED=0
ensure_hosts_config() {
  if state_hosts_changed "$HOSTS" || [ ! -f "$BPP_HOME/state/ssl/cert.pem" ] || [ ! -f "$BPP_HOME/state/hosts.env" ]; then
    CERT_CHANGED=1
    emit cert null "Generowanie certyfikatu dla: $HOSTS"
    cert_generate "$HOSTS" "$BPP_HOME/state/ssl" || fail "Nie udało się wygenerować certyfikatu"
    hosts_render_env "$HOSTS" >"$BPP_HOME/state/hosts.env" || fail "Nie udało się zapisać hosts.env"
    printf '%s\n' "$HOSTS" >"$BPP_HOME/state/hosts"
  fi
}

cmd_start() {
  local web_running="" rc
  PARSE_HOSTS_DEFAULT_SAVED=1 parse_hosts "$@"
  hwclock -s 2>/dev/null || true
  emit config null "Sprawdzanie konfiguracji"
  [ -f "$BPP_HOME/state/.env" ] || fail "Brak konfiguracji (state/.env) - uruchom najpierw init"
  wait_docker event

  ensure_hosts_config

  web_running="$(bpp_compose ps --status running -q webserver 2>/dev/null || true)"
  emit start null "Uruchamianie usług"
  # `up -d` blokuje na zdrowiu appservera (depends_on), czyli na migracjach:
  # migrate emitujemy przed nim, a calosc ograniczamy wspolnym limitem czasu.
  emit migrate null "Migracje bazy i start aplikacji (może potrwać kilka minut)"
  DEADLINE=$((SECONDS + ${BPP_HEALTH_TIMEOUT:-1800}))
  export -f bpp_compose
  rc=0
  timeout "${BPP_HEALTH_TIMEOUT:-1800}" bash -c 'bpp_compose up -d >&2' || rc=$?
  [ "$rc" -ne 124 ] || fail "Przekroczono limit czasu oczekiwania na start aplikacji (${BPP_HEALTH_TIMEOUT:-1800} s)"
  [ "$rc" -eq 0 ] || fail "docker compose up nie powiodło się"
  if [ "$CERT_CHANGED" = 1 ] && [ -n "$web_running" ]; then
    bpp_compose exec -T webserver nginx -s reload >&2 || fail "Nie udało się przeładować nginx"
  fi

  wait_healthy
  emit ready 1 "BPP jest gotowe: https://localhost:8443"
}

cmd_init() {
  parse_hosts "$@"
  emit config null "Przygotowanie konfiguracji"
  wait_docker event
  state_ensure_env || fail "Nie udało się utworzyć state/.env (brak image-tag?)"
  # compose (config --images) wymaga plikow env_file, w tym state/hosts.env.
  ensure_hosts_config
  pull_with_progress || fail "Pobieranie obrazów nie powiodło się"
  cmd_start --hosts "$HOSTS"
}

cmd_stop() {
  wait_docker
  bpp_compose stop >&2 || fail "docker compose stop nie powiodło się"
}

cmd_status() {
  local h running=false state=""
  h="$(appserver_health)"
  [ "$h" = absent ] ||
    state="$(bpp_compose ps --format json appserver 2>/dev/null | jq -rs 'flatten | .[0].State // ""' 2>/dev/null || true)"
  [ "$state" = running ] && running=true
  jq -cn --argjson running "$running" --arg health "$h" '{running: $running, health: $health}'
}

cmd_logs() {
  bpp_compose logs --tail 500 --no-color "$@" || fail "docker compose logs nie powiodło się"
}

# compose <args...> - docker compose tego stosu (state/.env, project-directory) do recznej pracy:
#   wsl -d BPP bpp-ctl compose ps | logs workerserver | up -d
cmd_compose() {
  trap - ERR
  wait_docker
  exec docker compose --project-directory "$BPP_HOME" -f "$BPP_HOME/docker-compose.yml" \
    --env-file "$BPP_HOME/state/.env" "$@"
}

# diag - raport diagnostyczny (zwykly tekst na stdout) do zgloszenia w IPLweb. Nigdy nie konczy sie
# bledem: kazda sekcja dziala osobno. Bez sekretow: nie pokazuje state/.env ani `compose config`.
cmd_diag() {
  trap - ERR
  set +e
  _section() {
    printf '\n===== %s =====\n' "$1"
    shift
    "$@" 2>&1
    local rc=$?
    [ "$rc" -eq 0 ] || echo "(kod wyjścia: $rc)"
  }
  echo "BPP - diagnostyka ($(date -Is 2>/dev/null || date))"
  _section "System" bash -c 'uname -a; grep PRETTY_NAME /etc/os-release; uptime; nproc'
  _section "Pamięć" free -m
  _section "Dysk" df -h / /var/lib/docker
  _section "Konfiguracja BPP (bez haseł)" bash -c '
    echo "image-tag: $(cat "$BPP_HOME/image-tag" 2>/dev/null)"
    grep -E "^BPP_IMAGE_TAG=" "$BPP_HOME/state/.env" 2>/dev/null
    echo "hosts: $(cat "$BPP_HOME/state/hosts" 2>/dev/null)"
    ls -l "$BPP_HOME/state" 2>/dev/null'
  _section "Usługa docker" systemctl --no-pager status docker
  if ! timeout 60 bash -c 'until docker info >/dev/null 2>&1; do sleep 1; done'; then
    echo
    echo "Docker nie odpowiada - pomijam sekcje kontenerów."
    _section "Dziennik dockerd" journalctl -u docker --no-pager -n 200
    return 0
  fi
  _section "Docker" docker version
  _section "Obrazy" docker images
  _section "Kontenery (compose ps -a)" bpp_compose ps --all
  _section "Healthcheck kontenerów" bash -c '
    for c in $(docker ps -aq --filter label=com.docker.compose.project=bpp); do
      docker inspect --format "{{.Name}}: state={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} restarts={{.RestartCount}} started={{.State.StartedAt}}" "$c"
      docker inspect --format "{{if .State.Health}}{{range .State.Health.Log}}  [{{.ExitCode}}] {{.Start}} {{printf \"%.300s\" .Output}}{{println}}{{end}}{{end}}" "$c"
    done'
  _section "Zużycie zasobów" docker stats --no-stream --no-trunc
  _section "Logi usług (ostatnie 1000 linii każdej)" bpp_compose logs --tail 1000 --timestamps --no-color
  _section "Dziennik dockerd" journalctl -u docker --no-pager -n 200
  _section "Jądro (OOM)" bash -c 'dmesg 2>/dev/null | grep -iE "oom|killed process" | tail -n 50'
  return 0
}

main() {
  local cmd="${1:-}"
  [ "$#" -eq 0 ] || shift
  case "$cmd" in
    init | start | stop | status | logs | diag | compose) "cmd_$cmd" "$@" ;;
    *) fail "Nieznane polecenie: '${cmd}' (init|start|stop|status|logs|diag|compose)" ;;
  esac
}

main "$@"
