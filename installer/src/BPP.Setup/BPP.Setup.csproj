<Project Sdk="Microsoft.NET.Sdk">

  <!-- The installer UI: a library linked into BPP.exe (BPP.Tray), started as BPP.exe with the setup switch. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BPP.Setup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Pinned rootfs (build/build.sh passes -p:RootfsUrl=… -p:RootfsSha256=…); empty in development builds. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RootfsUrl</_Parameter1>
      <_Parameter2>$(RootfsUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RootfsSha256</_Parameter1>
      <_Parameter2>$(RootfsSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\bpp.ico" LogicalName="BPP.Setup.bpp.ico" />
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="BPP.Setup.logo.png" />
    <EmbeddedResource Include="..\..\assets\logo-iplweb.png" LogicalName="BPP.Setup.logo-iplweb.png" />
    <EmbeddedResource Include="..\..\assets\LICENSE-BPP.txt" LogicalName="BPP.Setup.LICENSE-BPP.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPP.Core\BPP.Core.csproj" />
    <ProjectReference Include="..\BPP.Windows\BPP.Windows.csproj" />
  </ItemGroup>

</Project>
